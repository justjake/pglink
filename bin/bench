#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

# Build benchmark tool
./bin/go build -o out/bench ./cmd/bench

# Presets
case "${1:-}" in
    smoke)
        shift
        exec ./out/bench -duration 2s -warmup 1s -rounds 1 "$@"
        ;;
    full)
        shift
        exec ./out/bench -duration 10s -warmup 2s -rounds 6 "$@"
        ;;
    *)
        exec ./out/bench "$@"
        ;;
esac
