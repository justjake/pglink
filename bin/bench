#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
eval "$(mise activate bash --shims)"

cmd=(go run ./cmd/bench)

# Presets
case "${1:-}" in
    smoke)
        shift
        exec "${cmd[@]}" -duration 2s -warmup 1s -rounds 1 "$@"
        ;;
    full)
        shift
        exec "${cmd[@]}" -duration 10s -warmup 2s -rounds 6 "$@"
        ;;
    *)
        exec "${cmd[@]}" "$@"
        ;;
esac
